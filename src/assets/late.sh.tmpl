#!/bin/sh
set -eu
TARGET=/target
ASSETS=/clearme-assets

{{if .CloudInit}}
mkdir -p "$TARGET/var/lib/cloud/seed/nocloud" "$TARGET/etc/cloud/cloud.cfg.d"
chmod 700 "$TARGET/var/lib/cloud/seed/nocloud"
cp "$ASSETS/cloud-init/"* "$TARGET/var/lib/cloud/seed/nocloud/"
chmod 600 "$TARGET/var/lib/cloud/seed/nocloud/"*
cat > "$TARGET/etc/cloud/cloud.cfg.d/90-clearme-nocloud.cfg" <<'CLOUD'
datasource_list: [ NoCloud ]
datasource:
  NoCloud:
    seedfrom: file:///var/lib/cloud/seed/nocloud/
{{if .SystemSizeMB}}growpart:
  mode: 'off'
resize_rootfs: false
{{end}}
{{if not .CloudNetwork}}network:
  config: disabled
{{end}}CLOUD
{{end}}
mkdir -p "$TARGET/root/.clearme"
cp "$ASSETS/firstboot.sh" "$TARGET/root/.clearme/firstboot.sh"
# Generated by clearme.
cp "$ASSETS/fix-eth-name.sh" "$TARGET/root/.clearme/fix-eth-name.sh"
chmod 755 "$TARGET/root/.clearme/fix-eth-name.sh"
mkdir -p "$TARGET/etc/systemd/system/multi-user.target.wants"
cp "$ASSETS/fix-eth-name.service" "$TARGET/etc/systemd/system/clearme-fix-eth-name.service"
chmod 644 "$TARGET/etc/systemd/system/clearme-fix-eth-name.service"
ln -sf /etc/systemd/system/clearme-fix-eth-name.service \
    "$TARGET/etc/systemd/system/multi-user.target.wants/clearme-fix-eth-name.service"
chmod 755 "$TARGET/root/.clearme/firstboot.sh"
# Generated by clearme.
if [ -d "$ASSETS/optimize" ]; then
    mkdir -p "$TARGET/root/.clearme/optimize"
    cp "$ASSETS"/optimize/*.sh "$TARGET/root/.clearme/optimize/"
    chmod 755 "$TARGET/root/.clearme/optimize/"*.sh
fi
# Generated by clearme.
if [ -x "$ASSETS/cleanup.sh" ]; then
    cp "$ASSETS/cleanup.sh" "$TARGET/root/.clearme/cleanup.sh"
    chmod 755 "$TARGET/root/.clearme/cleanup.sh"
fi

# Generated by clearme.
mkdir -p "$TARGET/etc/apt/apt.conf.d"
cat > "$TARGET/etc/apt/apt.conf.d/99-disable-kernel-protection" <<'APTCONF'
APT::Protect-Kernels "false";
APTCONF
{{if .Proxy}}
# Generated by clearme.
cat > "$TARGET/etc/apt/apt.conf.d/99clearme-proxy" <<'APTPROXY'
Acquire::http::Proxy "{{.Proxy}}";
Acquire::https::Proxy "{{.Proxy}}";
APTPROXY
chmod 600 "$TARGET/etc/apt/apt.conf.d/99clearme-proxy"
{{end}}{{if .ExtraRepos}}
mkdir -p "$TARGET/etc/apt/sources.list.d"
cat > "$TARGET/etc/apt/sources.list.d/clearme-extra.list" <<'EXTRA'
{{range .ExtraRepos}}{{.}}
{{end}}EXTRA
{{end}}{{if .Unattended}}
# Generated by clearme.
mkdir -p "$TARGET/etc/apt/apt.conf.d"
cat > "$TARGET/etc/apt/apt.conf.d/20auto-upgrades" <<'AUTOUPGRADE'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
APT::Periodic::AutocleanInterval "7";
AUTOUPGRADE
{{end}}{{if .Fail2ban}}
# Generated by clearme.
mkdir -p "$TARGET/etc/fail2ban/jail.d"
cat > "$TARGET/etc/fail2ban/jail.d/clearme-sshd.local" <<'FAIL2BAN'
[sshd]
enabled = true
port = {{.SSHPort}}
FAIL2BAN
in-target systemctl enable fail2ban >/dev/null 2>&1 || true
{{end}}{{if .NTP}}
if [ ! -e "$TARGET/usr/lib/systemd/system/systemd-timesyncd.service" ] &&
    [ ! -e "$TARGET/lib/systemd/system/systemd-timesyncd.service" ]; then
    if ! in-target env DEBIAN_FRONTEND=noninteractive \
        apt-get install -y systemd-timesyncd >/dev/null 2>&1; then
        echo "clearme: systemd-timesyncd installation failed; NTP may not work" >&2
    fi
fi
# Generated by clearme.
mkdir -p "$TARGET/etc/systemd"
cat > "$TARGET/etc/systemd/timesyncd.conf" <<'TIMESYNC'
[Time]
NTP={{.NTP}}
TIMESYNC
in-target systemctl enable systemd-timesyncd >/dev/null 2>&1 || true
{{end}}
cat > "$TARGET/etc/systemd/system/clearme-firstboot.service" <<'UNIT'
[Unit]
Description=One-time first-boot initialization
After=network.target network-online.target
Wants=network-online.target
{{if .CloudInit}}After=cloud-final.service
Wants=cloud-final.service
{{end}}
ConditionPathExists=/root/.clearme/firstboot.sh

[Service]
Type=oneshot
ExecStart=/root/.clearme/firstboot.sh
RemainAfterExit=yes

[Install]
WantedBy={{if .CloudInit}}cloud-init.target{{else}}multi-user.target{{end}}
UNIT
mkdir -p "$TARGET/etc/systemd/system/{{if .CloudInit}}cloud-init{{else}}multi-user{{end}}.target.wants"
ln -sf /etc/systemd/system/clearme-firstboot.service \
    "$TARGET/etc/systemd/system/{{if .CloudInit}}cloud-init{{else}}multi-user{{end}}.target.wants/clearme-firstboot.service"

SSHD="$TARGET/etc/ssh/sshd_config"
if [ -f "$SSHD" ]; then
    sed -i -E 's/^#?Port .*/Port {{.SSHPort}}/' "$SSHD" || true
{{if eq .Username "root"}}    sed -i -E 's/^#?PermitRootLogin .*/PermitRootLogin yes/' "$SSHD" || true
{{else}}    sed -i -E 's/^#?PermitRootLogin .*/PermitRootLogin prohibit-password/' "$SSHD" || true
{{end}}{{if .AuthorizedKeys}}    sed -i -E 's/^#?PasswordAuthentication .*/PasswordAuthentication no/' "$SSHD" || true
{{end}}fi
{{if .AuthorizedKeys}}
mkdir -p "$TARGET{{.Home}}/.ssh"
chmod 700 "$TARGET{{.Home}}/.ssh"
in-target sh -c 'echo {{.KeysB64}} | base64 -d > {{.Home}}/.ssh/authorized_keys'
in-target chmod 600 {{.Home}}/.ssh/authorized_keys
{{if ne .Username "root"}}in-target chown -R {{.Username}}:{{.Username}} {{.Home}}/.ssh || true
{{end}}{{end}}{{if ne .Username "root"}}
printf '%s\n' '{{.Username}} ALL=(ALL:ALL) NOPASSWD:ALL' > "$TARGET/etc/sudoers.d/90-user-{{.Username}}"
chmod 440 "$TARGET/etc/sudoers.d/90-user-{{.Username}}"
{{end}}{{if .CloudNetwork}}
# cloud-init renders the explicitly supplied network-config before networking.
# Keep a single include instead of competing interface definitions.
mkdir -p "$TARGET/etc/network"
cat > "$TARGET/etc/network/interfaces" <<'CLOUDIFACES'
source /etc/network/interfaces.d/*
auto lo
iface lo inet loopback
CLOUDIFACES
{{else if .Interfaces}}
mkdir -p "$TARGET/etc/network"
cat > "$TARGET/etc/network/interfaces" <<'IFACES'
{{.Interfaces}}IFACES

if [ -f "$TARGET/etc/init.d/networking" ]; then
    in-target systemctl enable networking >/dev/null 2>&1 || true
fi
{{end}}{{if not .CloudNetwork}}{{if .ResolvConf}}
if [ ! -L "$TARGET/etc/resolv.conf" ]; then
cat > "$TARGET/etc/resolv.conf" <<'RESOLV'
{{.ResolvConf}}RESOLV
fi
{{end}}{{end}}{{if .KeepFstab}}
cat >> "$TARGET/etc/fstab" <<'FSTAB'
{{range .KeepFstab}}PARTUUID={{.PartUUID}} {{.MountPoint}} {{.FSType}} defaults,nofail 0 {{.Pass}}
{{end}}FSTAB
{{range .KeepFstab}}mkdir -p "$TARGET{{.MountPoint}}"
{{end}}{{end}}{{if .BtrfsCompress}}
if [ -f "$TARGET/etc/fstab" ]; then
    awk -v opt='compress={{.BtrfsCompress}}' '
        $2 == "/" {
            if (index("," $4 ",", ",compress=") == 0) {
                if ($4 == "") $4 = opt
                else $4 = $4 "," opt
            }
            print
            next
        }
        { print }
    ' "$TARGET/etc/fstab" > "$TARGET/etc/fstab.clearme"
    mv "$TARGET/etc/fstab.clearme" "$TARGET/etc/fstab"
fi
{{end}}
if ! in-target env DEBIAN_FRONTEND=noninteractive apt-get autoremove --purge -y; then
    echo "clearme: installation cleanup failed; it will be retried on first boot" >&2
fi

{{if .HoldAfter}}
echo 'clearme: installation finished; the target system is mounted at /target'
sh "$ASSETS/wait.sh"
{{end}}
exit 0
